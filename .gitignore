# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# ── Generated outputs (never commit proof/renders until quality-gated) ──
output/images/
output/metadata/
output/previews/
output/proof/
!output/**/.gitkeep
!output/README.md

# QA reports from local runs
reports/*.png
reports/*.json
!reports/README.md
!reports/.gitkeep

# Full-collection manifests (regenerable; large)
manifests/combos_*.json
manifests/combos_*.csv
manifests/images_sha256.txt
# Keep curation notes
!manifests/curation_report.json

# Secrets
.env
.env.*
